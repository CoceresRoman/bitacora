# Persistence (SQLite by default; point at Postgres if you prefer)
DATABASE_URL="file:./data/bitacora.db"

# 64 hex chars. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Telegram review channel
TELEGRAM_BOT_TOKEN=
# REQUIRED. The bot ignores every other chat. Without it the process refuses to boot.
TELEGRAM_ALLOWED_CHAT_ID=

# Local Claude CLI bridge (uses your Claude subscription, not an API key)
CLAUDE_BRIDGE_URL=http://127.0.0.1:8788
CLAUDE_BRIDGE_SECRET=

# LinkedIn app credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
LINKEDIN_API_VERSION=202508

# Content sources
GITHUB_USERNAME=
GITHUB_TOKEN=
LOCAL_REPOS=
TRENDS_REPOS=nestjs/nest,prisma/prisma

PORT=3000
